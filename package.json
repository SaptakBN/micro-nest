{
  "name": "@micro-nest/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev:auth": "dotenv -e .env.dev -e .env.dev.auth -- nx serve auth-service --skip-nx-cache",
    "build:auth": "dotenv -e .env.dev -e .env.dev.auth -- nx build auth-service --skip-nx-cache",
    "dev:user": "dotenv -e .env.dev -e .env.dev.user -- nx serve user-service --skip-nx-cache",
    "build:user": "dotenv -e .env.dev -e .env.dev.user -- nx build user-service --skip-nx-cache",
    "dev:gateway": "dotenv -e .env.dev -e .env.dev.gateway -- nx serve api-gateway --skip-nx-cache",
    "build:gateway": "dotenv -e .env.dev -e .env.dev.gateway -- nx build api-gateway --skip-nx-cache",
    "start": "concurrently --names \"AUTH_SERVICE,USER_SERVICE,API__GATEWAY\" --prefix \"[{name}]\" \"npm run dev:auth\" \"npm run dev:user\" \"npm run dev:gateway\"",
    "build": "concurrently --names \"AUTH_SERVICE,USER_SERVICE,API__GATEWAY\" --prefix \"[{name}]\" \"npm run build:auth\" \"npm run build:user\" \"npm run build:gateway\"",
    "migrate:auth:dev": "ENV_FILE=.env.dev.auth prisma migrate dev --schema apps/auth-service/prisma/schema.prisma --config apps/auth-service/prisma.config.ts",
    "migrate:auth:deploy": "ENV_FILE=.env.dev.auth prisma migrate deploy --schema apps/auth-service/prisma/schema.prisma --config apps/auth-service/prisma.config.ts",
    "migrate:user:dev": "ENV_FILE=.env.dev.user prisma migrate dev --schema apps/user-service/prisma/schema.prisma --config apps/user-service/prisma.config.ts",
    "migrate:user:deploy": "ENV_FILE=.env.dev.user prisma migrate deploy --schema apps/user-service/prisma/schema.prisma --config apps/user-service/prisma.config.ts",
    "generate-client:auth": "ENV_FILE=.env.dev.auth prisma generate --schema apps/auth-service/prisma/schema.prisma --config apps/auth-service/prisma.config.ts",
    "generate-client:user": "ENV_FILE=.env.dev.user prisma generate --schema apps/user-service/prisma/schema.prisma --config apps/user-service/prisma.config.ts",
    "docker:dev:down": "sudo docker compose -f docker-compose.dev.yml down",
    "docker:dev:up": "sudo docker compose -f docker-compose.dev.yml up -d",
    "docker:dev:restart": "sudo docker compose -f docker-compose.dev.yml restart",
    "docker:prod:build": "sudo docker compose build -d",
    "docker:prod:migrate:auth": "sudo docker compose run --rm migration-auth",
    "docker:prod:migrate:user": "sudo docker compose run --rm migration-user",
    "generate:contracts": "protoc --plugin=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=libs/common/contracts/src/lib/generated --ts_proto_opt=nestJs=true --ts_proto_opt=esModuleInterop=true --ts_proto_opt=snakeToCamel=false --ts_proto_opt=forceLong=string --ts_proto_opt=useOptionals=message --experimental_allow_proto3_optional --ts_proto_opt=stringEnums=true --ts_proto_opt=unrecognizedEnum=false -I ./libs/common/proto ./libs/common/proto/*.proto"
  },
  "private": true,
  "dependencies": {
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.1.19",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/adapter-mariadb": "^7.6.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/ms": "^2.1.0",
    "axios": "^1.6.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "http-proxy-middleware": "^3.0.5",
    "ioredis": "^5.10.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/docker": "22.6.4",
    "@nx/eslint": "22.6.4",
    "@nx/eslint-plugin": "22.6.4",
    "@nx/jest": "22.6.4",
    "@nx/js": "22.6.4",
    "@nx/nest": "22.6.4",
    "@nx/node": "22.6.4",
    "@nx/web": "22.6.4",
    "@nx/webpack": "22.6.4",
    "@nx/workspace": "22.6.4",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@swc/jest": "~0.2.38",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.39",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jest": "^30.0.2",
    "jest-environment-node": "^30.0.2",
    "jest-util": "^30.0.2",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "22.6.4",
    "prettier": "~3.6.2",
    "prisma": "^7.8.0",
    "protobufjs": "^8.0.1",
    "ts-jest": "^29.4.0",
    "ts-node": "10.9.1",
    "ts-proto": "^2.11.6",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "webpack-cli": "^5.1.4"
  },
  "workspaces": [
    "apps/*",
    "libs/shared/*",
    "libs/*",
    "libs/infra/*",
    "libs/common/*"
  ]
}